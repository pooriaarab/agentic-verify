{
  "name": "agentic-verify",
  "version": "0.1.0",
  "description": "Email verification for Node.js and AI agents with local syntax checks, MillionVerifier, ZeroBounce, CLI, and MCP tools.",
  "keywords": [
    "email-verification",
    "email-validation",
    "deliverability",
    "millionverifier",
    "zerobounce",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "ai-agents",
    "dry-run",
    "bulk-email"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-verify.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-verify",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-verify": "./dist/cli.js",
    "agentic-verify-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
